# All core providers (Haskoin, Haskoin mirror, Blockchair free tier,
# CoinPaprika, CoinGecko, Paytaca BCMR, FX) work with NO keys configured.
# The variables below are optional — only set them if you have keys and
# want higher rate limits from these specific providers.

# Maintainer-provided stopgap while api.haskoin.com resyncs.
# Defaults to https://api.blockchain.info/hashkoin-store/bch if unset.
HASKOIN_MIRROR_URL=

# Optional — raises Blockchair's free-tier rate limit.
BLOCKCHAIR_API_KEY=

# Optional — 3xpl works unauthenticated at low volume; a key raises limits.
THREEXPL_API_KEY=

# Not yet wired in (require paid plans on current free tiers as of this
# audit) — left here for when/if you add keys and enable them in
# lib/providers/index.js.
# TATUM_API_KEY=
# BLOCKDAEMON_API_KEY=
# CRYPTOAPIS_API_KEY=
